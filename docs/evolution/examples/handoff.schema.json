{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devos:spec:handoff:1",
  "title": "Proposed DEV/OS agent handoff v1",
  "type": "object",
  "required": ["schema_version", "mission_id", "task_id", "message_id", "reply_to", "sequence", "from", "to", "type", "summary", "expected_result", "acceptance", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "mission_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "message_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "reply_to": {"type": ["string", "null"], "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 1},
    "from": {"type": "string", "minLength": 1, "maxLength": 64},
    "to": {"type": "string", "minLength": 1, "maxLength": 64},
    "type": {"enum": ["proposal", "review_request", "changes_requested", "approved", "question", "done", "blocked"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "expected_result": {"type": "string", "minLength": 1, "maxLength": 2048},
    "acceptance": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "artifacts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "kind", "sha256", "base"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "kind": {"enum": ["patch", "snapshot", "test_report", "decision_note"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "base": {"type": ["string", "null"], "maxLength": 128}
        }
      }
    }
  }
}
